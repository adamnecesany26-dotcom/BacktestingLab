# API URL — pro lokální vývoj NEchte vyprázdněné nebo celý řádek vynechte:
#   prohlížeč volá /api/... na Next (:3000) a app/api/[...path]/route.ts proxy na FastAPI
#   Při HTTP 500 na /api/... a HTML těle s „Cannot find module './…js'“: smaž složku frontend/.next
#   a spusť znovu `npm run dev` (poškozená webpack cache v Nextu).
#   (řeší Windows/IPv6, když "localhost" v JS míří na ::1 a uvicorn jen na IPv4).
# Volitelně explicitně: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000  (ne localhost; obchází Next proxy — vhodné pro velmi dlouhý /api/artifacts/build)
# Produkce (UI a API odděleně): plná URL backendu.
# NEXT_PUBLIC_API_URL=
#
# Pouze server-side (Next proxy na backend):
# BACKEND_PROXY_URL=http://127.0.0.1:8000
# BACKEND_PROXY_FETCH_TIMEOUT_MS=172800000
#   (ms, 0 = bez AbortSignal ; unset = stejné jako DEFAULT_LONG_FETCH_MS v app/api/[...path]/route.ts)
#   Next maxDuration (sekundy) v route.ts musí být ≥ tento limit / 1000, jinak 502 po ~maxDuration.

# Firebase (backtestlab-5cbb7)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD4ezi08h7HDbh2XkG7UYFDSWoqVJRC0_M
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=backtestlab-5cbb7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=backtestlab-5cbb7
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=backtestlab-5cbb7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1074967818683
NEXT_PUBLIC_FIREBASE_APP_ID=1:1074967818683:web:f1e135a3c06bfc064e949e

# Optional: force anonymous sign-in (non-localhost or explicit opt-in).
# On http://localhost / 127.0.0.1 anonymous is tried automatically unless disabled below.
# Enable "Anonymous" in Firebase Console → Authentication → Sign-in method first.
# NEXT_PUBLIC_FIREBASE_ANONYMOUS_SIGNIN=1
# NEXT_PUBLIC_FIREBASE_DISABLE_AUTO_ANONYMOUS=1
