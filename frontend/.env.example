# Optional: force anonymous sign-in (non-localhost or explicit opt-in).
# On http://localhost / 127.0.0.1 anonymous is tried automatically unless disabled below.
# Enable "Anonymous" in Firebase Console → Authentication → Sign-in method first.
# NEXT_PUBLIC_FIREBASE_ANONYMOUS_SIGNIN=1
# NEXT_PUBLIC_FIREBASE_DISABLE_AUTO_ANONYMOUS=1
