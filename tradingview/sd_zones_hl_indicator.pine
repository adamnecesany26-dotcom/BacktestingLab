//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Cíl indikátoru:
//  • Najít institucionálně-relevantní Supply / Demand zóny (order blocks).
//  • Origin (base) zóny musí ležet ve stejné noze, která udělala BOS.
//  • READY (departure) se počítá zpětně od originu — nikdy „pozdě“ vůči BOS.
//  • Near-touch logika: probe (málem dotek) + STRONG departure ⇒ zóna končí.
//  • HTF (1D EMA200) auto-trend filter; quality slider 1–5; height clamping.
// ─────────────────────────────────────────────────────────────────────────────
indicator("S/D Zones (Pro)", shorttitle="S/D Pro", overlay=true, format=format.price,
     max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000)

// ════════════════════════════════════════════════════════════════════════════
// 1) USER INPUTS (intuitivní, sjednocené)
// ════════════════════════════════════════════════════════════════════════════
gB = "1) Swingy & BOS"
gZ = "2) Filtry zón"
gT = "3) Tvar & velikost"
gN = "4) Near-touch"
gV = "5) Vzhled"

// === 1) Swingy & BOS ===
int  uPivotBars        = input.int(5, "Pivot bars (L=R)", minval=2, maxval=20, group=gB,
     tooltip="Šířka pivotního okna nalevo i napravo. 2–4 = citlivé, 5–8 = vyvážené, 9+ = jen velké swingy.")
int  uSwingSensitivity = input.int(50, "Citlivost swingů (0–100)", minval=0, maxval=100, step=5, group=gB,
     tooltip="0 = velmi přísný (jen velké pohyby), 100 = velmi citlivý (i drobné). Reguluje min. rozestup mezi po sobě jdoucími swingy.")
bool uLocalExtMode     = input.bool(true, "Hledat lokální extrém kolem pivotu", group=gB,
     tooltip="Před registrací swingu prohledá okno ±N barů a pivot posune na skutečný lokální extrém (vyšší high / nižší low).")
int  uLocalExtRadius   = input.int(15, "Lokální okno (bary)", minval=3, maxval=80, group=gB,
     tooltip="Šířka okna pro hledání lepšího kandidáta swingu zpět od původního pivotu.")
int  uBosFollowBars    = input.int(2, "BOS follow-through (1–5)", minval=1, maxval=5, group=gB,
     tooltip="1 = BOS čistě na close (1 close za hranou). 2–5 = počet po sobě jdoucích close za hranou (cena pokračuje ve směru BOS).")
int  uBosLookbackBars  = input.int(200, "BOS lookback (bary)", minval=20, maxval=2000, group=gB,
     tooltip="Maximální stáří swingu, který může být BOS kandidátem. Brání tomu, aby se BOS lámal proti několik let starým swingům. 200 ≈ relevantní recent struktura.")

// === 2) Filtry zón ===
string uZoneSide   = input.string("Obě", "Generovat zóny", options=["Obě", "Demand", "Supply"], group=gZ)
int    uQuality    = input.int(3, "Kvalita zón (1–5)", minval=1, maxval=5, group=gZ,
     tooltip="Práh skóre 0–1: 1=0.20 (volné), 2=0.35, 3=0.50 (default), 4=0.65, 5=0.80 (jen špička).")
bool   uHtfTrend   = input.bool(true, "Filtrovat dle 1D trendu", group=gZ,
     tooltip="Demand jen v uptrendu, supply v downtrendu (1D close vs. 1D EMA 200). HTF se nastavuje sám.")
int    uMaxAlive   = input.int(10, "Max. živých zón na grafu", minval=1, maxval=20, group=gZ)
int    uMaxLifeBars= input.int(300, "Max. životnost zóny (bary)", minval=20, maxval=2000, group=gZ)

// === 3) Tvar & velikost ===
float  uMinHeightAtr  = input.float(0.20, "Min. výška zóny (×ATR)", minval=0.0, maxval=2.0, step=0.05, group=gT,
     tooltip="Příliš tenké zóny = šum. 0 = vypnuto.")
float  uMaxHeightAtr  = input.float(1.50, "Max. výška zóny (×ATR, clamping)", minval=0.3, maxval=5.0, step=0.05, group=gT,
     tooltip="Pokud je zóna větší, ořízne se na limit. Anchor: u demand zachovává LOW, u supply zachovává HIGH (zachovává hranu, kterou cena pravděpodobně testuje).")
float  uMinImpulseAtr = input.float(1.50, "Min. BOS impuls (×ATR)", minval=0.3, maxval=10.0, step=0.1, group=gT,
     tooltip="Délka pohybu z origin do BOS swingu. Slabé impulsy = slabé zóny.")
int    uMinBaseLen    = input.int(1, "Min. délka base (bary)", minval=1, maxval=10, group=gT)
int    uMaxBaseLen    = input.int(10, "Max. délka base (bary)", minval=2, maxval=40, group=gT)

// === 4) Near-touch ===
float uNtPadAtr    = input.float(0.18, "Near-touch pásmo (×ATR)", minval=0.0, maxval=1.0, step=0.02, group=gN,
     tooltip="0 = vypnuto. Probe = wick přiblíží na <X×ATR k vnější hraně, ale neudělá touch.")
float uNtStrongAtr = input.float(0.45, "Strong departure (×ATR)", minval=0.1, maxval=3.0, step=0.05, group=gN,
     tooltip="Po probe musí close odejít alespoň takto za hranu (od zóny pryč) — pak je zóna invalidována jako 'missed touch'.")

// === 5) Vzhled ===
color uColDemand    = input.color(color.new(#22c55e, 78), "Demand fill (alive)", group=gV)
color uColSupply    = input.color(color.new(#ef4444, 78), "Supply fill (alive)", group=gV)
color uColPending   = input.color(color.new(#94a3b8, 86), "Pending fill", group=gV)
color uColBorder    = input.color(color.new(#facc15, 35), "Hranice (border)", group=gV)
color uColBos       = input.color(color.new(#f59e0b, 0),  "BOS čára", group=gV)
bool  uShowPending  = input.bool(true,  "Zobrazit pending zóny", group=gV)
bool  uShowDead     = input.bool(true,  "Zobrazit historické (touched) zóny", group=gV,
     tooltip="Historické (mrtvé) zóny v zelené/červené barvě, jen více transparentní.")
bool  uShowBos      = input.bool(true,  "Zobrazit BOS čáry", group=gV)
bool  uShowSwings   = input.bool(false, "Body swingů", group=gV)
bool  uShowReady    = input.bool(false, "Značka READY (R)", group=gV)
bool  uShowTouch    = input.bool(true,  "Značka touch (T)", group=gV)
bool  uShowTfLabel  = input.bool(true,  "Štítek TF + 1D trend vpravo", group=gV)

// ════════════════════════════════════════════════════════════════════════════
// 2) CONSTANTS & DERIVED
// ════════════════════════════════════════════════════════════════════════════
float ATR_FLOOR  = 0.0001
int   ATR_PERIOD = 14

// Sensitivity → minimum bars between consecutive swings (gap).
// 0 % → 4× pivotBars (přísný), 100 % → 1× pivotBars (citlivý).
float sensFrac    = math.max(0.0, math.min(1.0, uSwingSensitivity / 100.0))
int   minSwingGap = math.max(2, int(math.round(uPivotBars * (1.0 + (1.0 - sensFrac) * 3.0))))

// Quality slider 1–5 → score threshold 0..1.
float qualityThr = uQuality == 1 ? 0.20 : uQuality == 2 ? 0.35 : uQuality == 3 ? 0.50 : uQuality == 4 ? 0.65 : 0.80

// ATR (chart TF).
atrVal = ta.atr(ATR_PERIOD)

// HTF auto: 1D close + 1D EMA200 (fixed jako institucionální majoritní trend).
[htfClose1D, htfEma1D] = request.security(syminfo.tickerid, "1D",
     [close, ta.ema(close, 200)], barmerge.gaps_off, barmerge.lookahead_off)
bool htfReady  = not na(htfClose1D) and not na(htfEma1D)
bool trendUp   = htfReady and htfClose1D >  htfEma1D
bool trendDown = htfReady and htfClose1D <  htfEma1D

// Když HTF data ještě nejsou (nejranější bary), trend-filter se NEAPLIKUJE — jinak
// bychom šuměli „žádné zóny“ na začátku historie.
bool allowDemand = (uZoneSide == "Obě" or uZoneSide == "Demand") and (not uHtfTrend or not htfReady or trendUp)
bool allowSupply = (uZoneSide == "Obě" or uZoneSide == "Supply") and (not uHtfTrend or not htfReady or trendDown)

// Y-scale anchors (skoro neviditelné) — drží auto-scale grafu.
plot(high,  title="(Y hi)", color=color.new(color.silver, 99), linewidth=1, display=display.all, editable=false)
plot(low,   title="(Y lo)", color=color.new(color.silver, 99), linewidth=1, display=display.all, editable=false)

// ════════════════════════════════════════════════════════════════════════════
// 3) HELPERS
// ════════════════════════════════════════════════════════════════════════════
f_safe_atr(float a) => na(a) or a <= ATR_FLOOR ? ATR_FLOOR : a
f_clamp01(float x) => x < 0 ? 0.0 : x > 1 ? 1.0 : x

// (f_atr_at odstraněno — inline ATR ve větvích kvůli CW10003)

// Čas na absolutním baru — kreslení přes `xloc.bar_time` (řeší RE10026; box/label očekávají series int).
// Pine: operátor historie `series[offset]` přijímá offset jen 0..10000 (RE10007 při větší vzdálenosti).
f_time_at_bar(int absBar) =>
    int rel = bar_index - absBar
    (rel < 0 or rel > 10000) ? int(na) : time[rel]

f_overlap_ratio(float bH, float bL, float zL, float zH) =>
    float rng = bH - bL
    rng <= 0 ? 0.0 : math.max(0.0, math.min(zH, bH) - math.max(zL, bL)) / rng

f_v_overlap_ratio(float aLo, float aHi, float bLo, float bHi) =>
    float oL = math.max(aLo, bLo)
    float oH = math.min(aHi, bHi)
    float o  = oH - oL
    float h1 = aHi - aLo
    float h2 = bHi - bLo
    float sm = math.min(h1, h2)
    o <= 0 or sm <= 0 ? 0.0 : o / sm

// ════════════════════════════════════════════════════════════════════════════
// 4) SWING DETECTION (lokální-extrém sweep + alternation)
// ════════════════════════════════════════════════════════════════════════════
var array<float> swingPx  = array.new_float()
var array<int>   swingBar = array.new_int()
var array<int>   swingTyp = array.new_int()    // 1 = high, -1 = low

var int    lastSwingBar  = -1000000
var string lastSwingType = na

// Native Pine pivots (potvrzeny uPivotBars do minulosti).
ph = ta.pivothigh(high, uPivotBars, uPivotBars)
pl = ta.pivotlow(low,   uPivotBars, uPivotBars)

// Lokální sweep: prohledá okno [candBar-radius, candBar] (jen potvrzené bary)
// a vrátí bar s nejvyšším / nejnižším extrémem. Tím vylepšíme major swingy
// (skutečné lokální maxima/minima, ne jen „přísnější“ pivot).
f_local_sweep_high(int candBar, int radius) =>
    int loB = math.max(0, candBar - radius)
    int hiB = math.min(bar_index - uPivotBars, candBar)
    int candOff = bar_index - candBar
    int   bestB = candBar
    float bestP = candOff >= 0 ? high[candOff] : na
    if hiB >= loB
        for b = loB to hiB
            int off = bar_index - b
            if off < 0 or off > 5000
                continue
            float px = high[off]
            if not na(px) and (na(bestP) or px > bestP or (px == bestP and b > bestB))
                bestP := px
                bestB := b
    [bestB, bestP]

f_local_sweep_low(int candBar, int radius) =>
    int loB = math.max(0, candBar - radius)
    int hiB = math.min(bar_index - uPivotBars, candBar)
    int candOff = bar_index - candBar
    int   bestB = candBar
    float bestP = candOff >= 0 ? low[candOff] : na
    if hiB >= loB
        for b = loB to hiB
            int off = bar_index - b
            if off < 0 or off > 5000
                continue
            float px = low[off]
            if not na(px) and (na(bestP) or px < bestP or (px == bestP and b > bestB))
                bestP := px
                bestB := b
    [bestB, bestP]

if barstate.isconfirmed and bar_index >= uPivotBars * 2
    int pivBar = bar_index - uPivotBars

    // Pivot HIGH kandidát.
    if not na(ph)
        int   finalBar = pivBar
        float finalPx  = ph
        if uLocalExtMode
            [bb, bp] = f_local_sweep_high(pivBar, uLocalExtRadius)
            finalBar := bb
            finalPx  := bp
        int n = array.size(swingBar)
        if n > 0 and array.get(swingTyp, n - 1) == 1
            // Stejný typ jako poslední — nahrad, pokud nový high je vyšší (oprava
            // chronického problému: po pivotu může přijít vyšší high a my ho jinak ztratíme).
            if finalPx > array.get(swingPx, n - 1)
                array.set(swingPx,  n - 1, finalPx)
                array.set(swingBar, n - 1, finalBar)
                lastSwingBar := finalBar
        else
            if (finalBar - lastSwingBar) >= minSwingGap
                array.push(swingBar, finalBar)
                array.push(swingPx,  finalPx)
                array.push(swingTyp, 1)
                lastSwingBar  := finalBar
                lastSwingType := "high"
    else if not na(pl)
        int   finalBar = pivBar
        float finalPx  = pl
        if uLocalExtMode
            [bb, bp] = f_local_sweep_low(pivBar, uLocalExtRadius)
            finalBar := bb
            finalPx  := bp
        int n = array.size(swingBar)
        if n > 0 and array.get(swingTyp, n - 1) == -1
            if finalPx < array.get(swingPx, n - 1)
                array.set(swingPx,  n - 1, finalPx)
                array.set(swingBar, n - 1, finalBar)
                lastSwingBar := finalBar
        else
            if (finalBar - lastSwingBar) >= minSwingGap
                array.push(swingBar, finalBar)
                array.push(swingPx,  finalPx)
                array.push(swingTyp, -1)
                lastSwingBar  := finalBar
                lastSwingType := "low"

    while array.size(swingBar) > 300
        array.shift(swingBar)
        array.shift(swingPx)
        array.shift(swingTyp)

// ════════════════════════════════════════════════════════════════════════════
// 5) BOS LEVEL HELPERS (broken-mark, leg search, origin = order block)
// ════════════════════════════════════════════════════════════════════════════
var array<int> brokenHighBars = array.new_int()
var array<int> brokenLowBars  = array.new_int()

// Pozice (bar) posledního BOS swingu — slouží k tomu, aby se BOS lámal jen na
// swinzích, které nastaly POZDĚJI než předchozí BOS. Tím se zabrání zavalení
// grafu "phantom BOS" čárami u staré struktury, kterou už cena dávno prolomila.
var int lastBosUpSwingBar = -1
var int lastBosDnSwingBar = -1

// Cap BOS line objektů — UI cleanliness.
var array<line> bosLines = array.new_line()
int BOS_LINES_CAP = 30

f_was_broken_h(int sb) => array.indexof(brokenHighBars, sb) >= 0
f_was_broken_l(int sb) => array.indexof(brokenLowBars,  sb) >= 0

// Najde nejnovější swing daného typu, jehož bar je < beforeBar.
f_last_swing_of(int wantTyp, int beforeBar) =>
    int n = array.size(swingBar)
    int outBar = na
    if n > 0
        for i = n - 1 to 0
            if array.get(swingTyp, i) == wantTyp and array.get(swingBar, i) < beforeBar
                outBar := array.get(swingBar, i)
                break
    outBar

// Origin demand zóny = poslední BEARISH (close<open) svíčka v BOS noze. Fallback = nejnižší low.
// Tím garantujeme, že base je VŽDY ve stejné noze, která udělala BOS.
f_origin_demand(int legStart, int legEnd) =>
    int outBar = na
    int b = legEnd
    while b >= legStart and b >= 0
        int off = bar_index - b
        if off >= 0 and off <= 5000
            float c = close[off]
            float o = open[off]
            if not na(c) and not na(o) and c < o
                outBar := b
                break
        b -= 1
    if na(outBar)
        int   lowB = legStart
        float lowP = na
        if legEnd >= legStart
            for k = legStart to legEnd
                int off = bar_index - k
                if off < 0 or off > 5000
                    continue
                float lk = low[off]
                if na(lk)
                    continue
                if na(lowP) or lk < lowP
                    lowP := lk
                    lowB := k
        outBar := lowB
    outBar

// Origin supply = poslední BULLISH (close>open) svíčka v BOS noze. Fallback = nejvyšší high.
f_origin_supply(int legStart, int legEnd) =>
    int outBar = na
    int b = legEnd
    while b >= legStart and b >= 0
        int off = bar_index - b
        if off >= 0 and off <= 5000
            float c = close[off]
            float o = open[off]
            if not na(c) and not na(o) and c > o
                outBar := b
                break
        b -= 1
    if na(outBar)
        int   hiB = legStart
        float hiP = na
        if legEnd >= legStart
            for k = legStart to legEnd
                int off = bar_index - k
                if off < 0 or off > 5000
                    continue
                float hk = high[off]
                if na(hk)
                    continue
                if na(hiP) or hk > hiP
                    hiP := hk
                    hiB := k
        outBar := hiB
    outBar

// ════════════════════════════════════════════════════════════════════════════
// 6) ZONE STATE (paralelní pole)
// ════════════════════════════════════════════════════════════════════════════
var array<box>   zBox       = array.new_box()
var array<float> zLo        = array.new_float()
var array<float> zHi        = array.new_float()
var array<int>   zDir       = array.new_int()      // 1=demand, -1=supply
var array<int>   zPivot     = array.new_int()      // origin bar
var array<int>   zBosBar    = array.new_int()
var array<int>   zBorn      = array.new_int()      // bar, kdy byla zóna fyzicky vytvořena
var array<int>   zEndBar    = array.new_int()
var array<bool>  zReady     = array.new_bool()
var array<int>   zReadyBar  = array.new_int()
var array<bool>  zTouched   = array.new_bool()
var array<bool>  zAlive     = array.new_bool()
var array<int>   zEndReason = array.new_int()      // 1=close inv, 2=touch, 3=near-touch missed, 5=max-life
var array<bool>  zNtArm     = array.new_bool()     // near-touch FSM
var array<float> zScore     = array.new_float()
var array<int>   zBaseLen   = array.new_int()

f_count_alive() =>
    int c = 0
    int n = array.size(zAlive)
    if n > 0
        for i = 0 to n - 1
            if array.get(zAlive, i)
                c += 1
    c

// Skóre 0..1: dominuje impuls (departure síla); pak base sanity; pak anti-chop.
f_zone_score(float impulseAtr, int baseLen, float chopDensity) =>
    float sImp  = f_clamp01(impulseAtr / 3.0)
    float sBase = f_clamp01(1.0 - math.abs(float(baseLen) - 3.0) / 6.0)
    float sChop = f_clamp01(1.0 - chopDensity)
    f_clamp01(0.55 * sImp + 0.20 * sBase + 0.25 * sChop)

// Bounds zóny z origin svíčky (wick-to-body — institucionálně-relevantní obrys).
f_zone_bounds(int origBar, int dir) =>
    int off = bar_index - origBar
    float lo = low[off]
    float hi = high[off]
    float op = open[off]
    float cl = close[off]
    float outLo = lo
    float outHi = hi
    if dir == 1
        outHi := math.max(op, cl)
    else
        outLo := math.min(op, cl)
    [outLo, outHi]

// Ořezání nadměrné výšky — kotví edge, kterou cena pravděpodobně testuje
// (demand: spodní hrana = LOW; supply: horní hrana = HIGH). Tím držíme
// stop-loss logiku smysluplnou i u velkých svíček.
f_clamp_height(float zL, float zH, int dir, float atr) =>
    float outL = zL
    float outH = zH
    if uMaxHeightAtr > 0 and atr > ATR_FLOOR
        float capW = uMaxHeightAtr * atr
        float h = zH - zL
        if h > capW
            if dir == 1
                outH := zL + capW
            else
                outL := zH - capW
    [outL, outH]

// Délka base = počet po sobě jdoucích barů na obou stranách originu, které jsou stále v zóně.
f_base_len(int origBar, float zL, float zH) =>
    int left  = origBar
    int right = origBar
    for j = 1 to 30
        int b = origBar - j
        if b < 0
            break
        int off = bar_index - b
        if off < 0 or off > 5000
            break
        if f_overlap_ratio(high[off], low[off], zL, zH) >= 0.40
            left := b
        else
            break
    for j = 1 to 30
        int b = origBar + j
        if b > bar_index
            break
        int off = bar_index - b
        if off < 0 or off > 5000
            break
        if f_overlap_ratio(high[off], low[off], zL, zH) >= 0.40
            right := b
        else
            break
    right - left + 1

// Hustota chop barů v okně (kolik bar překryvů ≥ 30 % s pásmem).
f_chop_density(int leftStart, int rightEnd, float zL, float zH) =>
    float dens = 0.0
    int span = rightEnd - leftStart + 1
    if span > 0
        int cnt = 0
        for k = leftStart to rightEnd
            int off = bar_index - k
            if off < 0 or off > 5000
                continue
            if f_overlap_ratio(high[off], low[off], zL, zH) >= 0.30
                cnt += 1
        dens := float(cnt) / float(span)
    dens

// Brání duplikátům: nová zóna stejného typu se nesmí výrazně překrývat se živou.
f_zone_overlaps_existing(float zL, float zH, int dir) =>
    bool hit = false
    int n = array.size(zBox)
    if n > 0
        for i = 0 to n - 1
            if array.get(zAlive, i) and array.get(zDir, i) == dir
                float iL = math.min(array.get(zLo, i), array.get(zHi, i))
                float iH = math.max(array.get(zLo, i), array.get(zHi, i))
                float ol = f_v_overlap_ratio(zL, zH, iL, iH)
                if ol >= 0.50
                    hit := true
                    break
    hit

// Backfill stavu zóny od originu+1 do aktuálního baru — řeší „pozdní READY“
// problém. Zóna od narození zná svůj reálný životní cyklus.
// Vrací: [alive, ready, readyBar, touched, endBar, endReason, ntArm].
f_backfill_state(int origBar, int dir, float zL, float zH) =>
    bool alive   = true
    bool ready   = false
    int  readyBar= -1
    bool touched = false
    int  endBar  = bar_index
    int  endReas = 0
    bool ntArm   = false

    int start = origBar + 1
    if start > bar_index
        start := bar_index

    bool brk = false
    for j = start to bar_index
        if brk
            break
        int off = bar_index - j
        if off < 0 or off > 5000
            continue
        float bH = high[off]
        float bL = low[off]
        float bC = close[off]
        if na(bH) or na(bL) or na(bC)
            continue
        // Inline ATR (ne f_atr_at v cyklu — CW10003)
        int relAtr = bar_index - j
        int relAtrC = relAtr < 0 ? 0 : (relAtr > 5000 ? 5000 : relAtr)
        float atrJ = na(atrVal[relAtrC]) or atrVal[relAtrC] <= ATR_FLOOR ? ATR_FLOOR : atrVal[relAtrC]

        // 1) Close-invalidation kdykoliv (i pre-READY).
        if (dir == 1 and bC < zL) or (dir == -1 and bC > zH)
            alive := false
            touched := true
            endBar := j
            endReas := 1
            brk := true
            continue

        bool overlap = bL <= zH and bH >= zL

        // 2) READY (departure): close zajede za hranu o min. 0.30×ATR.
        if not ready
            float depNeed = atrJ * 0.30
            bool departClose = dir == 1 ? (bC > zH + depNeed) : (bC < zL - depNeed)
            if departClose
                ready := true
                readyBar := j

        // 3) Touch po READY → konec.
        if ready and j > readyBar and overlap
            touched := true
            endBar := j
            endReas := 2
            alive := false
            brk := true
            continue

        // 4) Near-touch: probe + strong departure (nebo armed + strong departure).
        if uNtPadAtr > 0 and not overlap
            float ntPad = uNtPadAtr * atrJ
            float ntStr = uNtStrongAtr * atrJ
            bool isProbe = dir == 1 ? (bL <= zH + ntPad and bL > zH) : (bH >= zL - ntPad and bH < zL)
            bool isStrongDepart = dir == 1 ? (bC > zH + ntStr) : (bC < zL - ntStr)
            bool nearKill = (isProbe and isStrongDepart) or (ntArm and isStrongDepart)
            if nearKill
                alive := false
                touched := true
                endBar := j
                endReas := 3
                brk := true
                continue
            if isProbe and not isStrongDepart
                ntArm := true

        // 5) Max life.
        if uMaxLifeBars > 0 and (j - origBar) >= uMaxLifeBars
            alive := false
            endBar := j
            endReas := 5
            brk := true
            continue

    [alive, ready, readyBar, touched, endBar, endReas, ntArm]

// Konstrukce nové zóny: filtry kvality + backfill + push do polí.
f_try_create_zone(int origBar, int dir, float bosSwingPx, int bosBar) =>
    bool ok = false
    int off = bar_index - origBar
    if off >= 0 and off <= 5000 and f_count_alive() < uMaxAlive
        int relP = bar_index - origBar
        int relPC = relP < 0 ? 0 : (relP > 5000 ? 5000 : relP)
        float atrP = na(atrVal[relPC]) or atrVal[relPC] <= ATR_FLOOR ? ATR_FLOOR : atrVal[relPC]
        [zL0, zH0] = f_zone_bounds(origBar, dir)
        if zH0 > zL0
            [zL, zH] = f_clamp_height(zL0, zH0, dir, atrP)
            float h = zH - zL
            bool minHOk = uMinHeightAtr <= 0 or h >= uMinHeightAtr * atrP
            float origPxImp = dir == 1 ? low[off] : high[off]
            float impulse   = dir == 1 ? (bosSwingPx - origPxImp) : (origPxImp - bosSwingPx)
            float impAtr    = atrP > ATR_FLOOR ? impulse / atrP : 0.0
            bool impOk      = impAtr >= uMinImpulseAtr
            int  baseLen    = f_base_len(origBar, zL, zH)
            bool baseOk     = baseLen >= uMinBaseLen and baseLen <= uMaxBaseLen
            float chopD     = f_chop_density(math.max(0, origBar - 30), bar_index, zL, zH)
            float score     = f_zone_score(impAtr, baseLen, chopD)
            bool scoreOk    = score >= qualityThr
            bool noOverlap  = not f_zone_overlaps_existing(zL, zH, dir)
            // backfill vždy až máme finální zL/zH, ale neuvnitř „if minHOk && …“ (CW10003)
            [bfA, bfR, bfRb, bfT, bfEb, bfEr, bfNt] = f_backfill_state(origBar, dir, zL, zH)
            bool filtersOk = minHOk and impOk and baseOk and scoreOk and noOverlap
            if filtersOk and (bfA or bfR)
                // Vyhazujeme zóny, které „umřely“ ještě než se staly READY (zbytečný šum).
                // Po backfillu může zóna rovnou narodit jako "dead" (touched). Použijeme
                // zafadenou green/red barvu (stejně jako v render bloku).
                float aliveTransBf = dir == 1 ? color.t(uColDemand) : color.t(uColSupply)
                float deadTransBf  = math.min(100.0, aliveTransBf + 12.0)
                color deadColorBf = dir == 1 ? color.new(uColDemand, deadTransBf) : color.new(uColSupply, deadTransBf)
                color fillC = bfA ? (bfR ? (dir == 1 ? uColDemand : uColSupply) : uColPending) : deadColorBf
                int rightX = bfA ? bar_index : bfEb
                int tL = f_time_at_bar(origBar)
                int tR = f_time_at_bar(rightX)
                if not na(tL) and not na(tR)
                    box bx = box.new(left=tL, top=zH, right=tR, bottom=zL,
                         xloc=xloc.bar_time, bgcolor=fillC,
                         border_color=uColBorder, border_width=1, border_style=line.style_dashed)
                    array.push(zBox,       bx)
                    array.push(zLo,        zL)
                    array.push(zHi,        zH)
                    array.push(zDir,       dir)
                    array.push(zPivot,     origBar)
                    array.push(zBosBar,    bosBar)
                    array.push(zBorn,      bar_index)
                    array.push(zEndBar,    rightX)
                    array.push(zReady,     bfR)
                    array.push(zReadyBar,  bfRb)
                    array.push(zTouched,   bfT)
                    array.push(zAlive,     bfA)
                    array.push(zEndReason, bfEr)
                    array.push(zNtArm,     bfNt)
                    array.push(zScore,     score)
                    array.push(zBaseLen,   baseLen)
                    ok := true
    ok

// ════════════════════════════════════════════════════════════════════════════
// 7) BOS DETECTION (potvrzení = N po sobě jdoucích close za hranou)
// ──────────────────────────────────────────────────────────────────────
// Klíčová pravidla relevance:
//  • Kandidát musí být POZDĚJI než poslední BOS swing (lastBosUpSwingBar / Dn).
//  • Stáří kandidáta ≤ uBosLookbackBars (relevantní recent struktura).
//  • Kandidát musí ležet v "history-window" Pine [0..10000] (RE10007 safe).
// Tím odpadne kreslení BOS proti několik let staré struktuře a zbytečné čáry.
// ════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed and bar_index >= uBosFollowBars
    int A = uBosFollowBars
    int bosBar = bar_index - A + 1     // první close streaku
    int minRelevantBar = bar_index - uBosLookbackBars
    int historyFloor   = bar_index - 10000  // RE10007 safety

    // ── BOS up ──
    float minCloseLastA = close
    for k = 0 to A - 1
        float c = close[k]
        if not na(c) and c < minCloseLastA
            minCloseLastA := c

    int   bestHBar = na
    float bestHPx  = na
    int   nS = array.size(swingBar)
    if nS > 0
        for i = 0 to nS - 1
            if array.get(swingTyp, i) == 1
                int sb = array.get(swingBar, i)
                float sp = array.get(swingPx, i)
                bool relevant = sb > lastBosUpSwingBar and sb >= minRelevantBar and sb >= historyFloor
                if relevant and sb <= bosBar - 1 and sp < minCloseLastA and not f_was_broken_h(sb)
                    if na(bestHBar) or sp > bestHPx
                        bestHBar := sb
                        bestHPx  := sp

    if not na(bestHBar)
        // Označit jako broken všechny swing-highy ≤ bestHPx (potlačí re-fire na stejných úrovních).
        for i = 0 to nS - 1
            if array.get(swingTyp, i) == 1
                int sb = array.get(swingBar, i)
                float sp = array.get(swingPx, i)
                if sp <= bestHPx and not f_was_broken_h(sb)
                    array.push(brokenHighBars, sb)
        // Posun "BOS frontier" — další BOS up bude jen na NOVĚJŠÍ swing.
        lastBosUpSwingBar := bestHBar
        if uShowBos
            int tBosH = f_time_at_bar(bestHBar)
            if not na(tBosH)
                line ln = line.new(tBosH, bestHPx, time, bestHPx,
                     xloc=xloc.bar_time, color=uColBos, width=1, style=line.style_dashed)
                array.push(bosLines, ln)
                while array.size(bosLines) > BOS_LINES_CAP
                    line.delete(array.shift(bosLines))
        if allowDemand
            // BOS leg = od posledního swing-low PŘED BOS streakem do BOS baru. Origin (= base / order block) leží
            // uvnitř téhle nohy — institucionálně správné určení a klíčová oprava oproti dřívější logice (vybírala
            // swing před broken-high → mohlo to být i 3 swingy zpět).
            int legStart = f_last_swing_of(-1, bosBar)
            if na(legStart)
                legStart := math.max(0, bosBar - 50)
            int legEnd = bosBar
            if legEnd < legStart
                legEnd := legStart
            int origin = f_origin_demand(legStart, legEnd)
            if not na(origin)
                f_try_create_zone(origin, 1, bestHPx, bosBar)

    while array.size(brokenHighBars) > 200
        array.shift(brokenHighBars)

    // ── BOS down ──
    float maxCloseLastA = close
    for k = 0 to A - 1
        float c = close[k]
        if not na(c) and c > maxCloseLastA
            maxCloseLastA := c

    int   bestLBar = na
    float bestLPx  = na
    if nS > 0
        for i = 0 to nS - 1
            if array.get(swingTyp, i) == -1
                int sb = array.get(swingBar, i)
                float sp = array.get(swingPx, i)
                bool relevant = sb > lastBosDnSwingBar and sb >= minRelevantBar and sb >= historyFloor
                if relevant and sb <= bosBar - 1 and sp > maxCloseLastA and not f_was_broken_l(sb)
                    if na(bestLBar) or sp < bestLPx
                        bestLBar := sb
                        bestLPx  := sp

    if not na(bestLBar)
        for i = 0 to nS - 1
            if array.get(swingTyp, i) == -1
                int sb = array.get(swingBar, i)
                float sp = array.get(swingPx, i)
                if sp >= bestLPx and not f_was_broken_l(sb)
                    array.push(brokenLowBars, sb)
        lastBosDnSwingBar := bestLBar
        if uShowBos
            int tBosL = f_time_at_bar(bestLBar)
            if not na(tBosL)
                line ln = line.new(tBosL, bestLPx, time, bestLPx,
                     xloc=xloc.bar_time, color=uColBos, width=1, style=line.style_dashed)
                array.push(bosLines, ln)
                while array.size(bosLines) > BOS_LINES_CAP
                    line.delete(array.shift(bosLines))
        if allowSupply
            // BOS leg = od posledního swing-high PŘED BOS streakem do BOS baru.
            int legStart = f_last_swing_of(1, bosBar)
            if na(legStart)
                legStart := math.max(0, bosBar - 50)
            int legEnd = bosBar
            if legEnd < legStart
                legEnd := legStart
            int origin = f_origin_supply(legStart, legEnd)
            if not na(origin)
                f_try_create_zone(origin, -1, bestLPx, bosBar)

    while array.size(brokenLowBars) > 200
        array.shift(brokenLowBars)

// ════════════════════════════════════════════════════════════════════════════
// 8) ZONE LIFECYCLE (per-bar update živých zón)
// ════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    int nz = array.size(zBox)
    if nz > 0
        for zi = 0 to nz - 1
            if array.get(zAlive, zi)
                int   dir   = array.get(zDir, zi)
                float zL    = math.min(array.get(zLo, zi), array.get(zHi, zi))
                float zH    = math.max(array.get(zLo, zi), array.get(zHi, zi))
                int   piv   = array.get(zPivot, zi)
                int   born  = array.get(zBorn, zi)
                bool  ready = array.get(zReady, zi)
                int   readyBar = array.get(zReadyBar, zi)
                bool  ntArm = array.get(zNtArm, zi)
                float atrZ  = f_safe_atr(atrVal)

                if bar_index >= born
                    float bH = high
                    float bL = low
                    float bC = close
                    bool overlap = bL <= zH and bH >= zL
                    bool handled = false

                    // 1) Close-invalidation.
                    if (dir == 1 and bC < zL) or (dir == -1 and bC > zH)
                        array.set(zAlive,     zi, false)
                        array.set(zTouched,   zi, true)
                        array.set(zEndBar,    zi, bar_index)
                        array.set(zEndReason, zi, 1)
                        if uShowTouch
                            float yLab = dir == 1 ? zL : zH
                            label.new(bar_index, yLab, xloc=xloc.bar_index, yloc=yloc.price,
                                 text="T", style=dir == 1 ? label.style_label_up : label.style_label_down,
                                 color=color.new(uColBorder, 25), textcolor=color.white, size=size.tiny,
                                 tooltip="Close invalidation")
                        handled := true

                    // 2) READY (departure).
                    if not handled and not ready
                        float depNeed = atrZ * 0.30
                        bool departClose = dir == 1 ? (bC > zH + depNeed) : (bC < zL - depNeed)
                        if departClose
                            array.set(zReady,    zi, true)
                            array.set(zReadyBar, zi, bar_index)
                            ready := true
                            readyBar := bar_index
                            if uShowReady
                                float yLab = dir == 1 ? zH : zL
                                label.new(bar_index, yLab, xloc=xloc.bar_index, yloc=yloc.price,
                                     text="R", style=dir == 1 ? label.style_label_down : label.style_label_up,
                                     color=color.new(uColBorder, 55), textcolor=color.white, size=size.tiny,
                                     tooltip="READY (departure close)")

                    // 3) Real touch po READY → konec.
                    if not handled and ready and bar_index > readyBar and overlap
                        array.set(zAlive,     zi, false)
                        array.set(zTouched,   zi, true)
                        array.set(zEndBar,    zi, bar_index)
                        array.set(zEndReason, zi, 2)
                        if uShowTouch
                            float yLab = dir == 1 ? zH : zL
                            label.new(bar_index, yLab, xloc=xloc.bar_index, yloc=yloc.price,
                                 text="T", style=dir == 1 ? label.style_label_down : label.style_label_up,
                                 color=color.new(uColBorder, 25), textcolor=color.white, size=size.tiny,
                                 tooltip="Touch (post-READY)")
                        handled := true

                    // 4) Near-touch FSM: probe + strong departure ⇒ kill.
                    if not handled and uNtPadAtr > 0 and not overlap
                        float ntPad = uNtPadAtr * atrZ
                        float ntStr = uNtStrongAtr * atrZ
                        bool isProbe = dir == 1 ? (bL <= zH + ntPad and bL > zH) : (bH >= zL - ntPad and bH < zL)
                        bool isStrongDepart = dir == 1 ? (bC > zH + ntStr) : (bC < zL - ntStr)
                        bool nearKill = (isProbe and isStrongDepart) or (ntArm and isStrongDepart)
                        if nearKill
                            array.set(zAlive,     zi, false)
                            array.set(zTouched,   zi, true)
                            array.set(zEndBar,    zi, bar_index)
                            array.set(zEndReason, zi, 3)
                            if uShowTouch
                                float yLab = dir == 1 ? zH : zL
                                label.new(bar_index, yLab, xloc=xloc.bar_index, yloc=yloc.price,
                                     text="T*", style=dir == 1 ? label.style_label_down : label.style_label_up,
                                     color=color.new(#a855f7, 35), textcolor=color.white, size=size.tiny,
                                     tooltip="Near-touch missed: probe + strong departure (cena už 'v zóně byla', odešla pryč)")
                            handled := true
                        else if isProbe and not isStrongDepart
                            array.set(zNtArm, zi, true)

                    // 5) Max life.
                    if not handled and uMaxLifeBars > 0 and (bar_index - piv) >= uMaxLifeBars
                        array.set(zAlive,     zi, false)
                        array.set(zEndBar,    zi, bar_index)
                        array.set(zEndReason, zi, 5)
                        handled := true

                    // 6) Update live right edge (`bar_time` — párování k boxům z box.new výše).
                    if not handled and array.get(zAlive, zi)
                        box bb = array.get(zBox, zi)
                        box.set_right(bb, time)
                        array.set(zEndBar, zi, bar_index)

// ════════════════════════════════════════════════════════════════════════════
// 9) RENDERING (sync barev + viditelnosti)
// ════════════════════════════════════════════════════════════════════════════
int nzVis = array.size(zBox)
if nzVis > 0
    for zi = 0 to nzVis - 1
        bool alv  = array.get(zAlive,   zi)
        bool rdy  = array.get(zReady,   zi)
        int  dir  = array.get(zDir,     zi)
        bool isDem = dir == 1
        box  zb   = array.get(zBox, zi)
        bool sideOk = (uZoneSide == "Obě") or (uZoneSide == "Demand" and isDem) or (uZoneSide == "Supply" and not isDem)
        bool show = sideOk
        if not alv
            show := show and uShowDead
        else if not rdy
            show := show and uShowPending
        if show
            // Historické (mrtvé) zóny: zachováme green/red, jen + alpha pro odlišení.
            float aliveTrans   = isDem ? color.t(uColDemand) : color.t(uColSupply)
            float deadTrans    = math.min(100.0, aliveTrans + 12.0)
            color liveColor  = isDem ? uColDemand : uColSupply
            color deadColor  = isDem ? color.new(uColDemand, deadTrans) : color.new(uColSupply, deadTrans)
            color borderLive = uColBorder
            color borderDead = color.new(uColBorder, math.min(100.0, color.t(uColBorder) + 25.0))
            color fillC = alv ? (rdy ? liveColor : uColPending) : deadColor
            color borderC = alv ? borderLive : borderDead
            box.set_bgcolor(zb, fillC)
            box.set_border_color(zb, borderC)
        else
            box.set_bgcolor(zb, color.new(color.gray, 100))
            box.set_border_color(zb, color.new(uColBorder, 100))

// ════════════════════════════════════════════════════════════════════════════
// 10) SWING DOTS
// ════════════════════════════════════════════════════════════════════════════
var array<label> swingLbls = array.new_label()
var int prevTipBar = na

if barstate.isconfirmed and uShowSwings
    int nSL = array.size(swingBar)
    if nSL > 0
        int tip = array.get(swingBar, nSL - 1)
        if na(prevTipBar) or tip != prevTipBar
            int   typ = array.get(swingTyp, nSL - 1)
            float px  = array.get(swingPx,  nSL - 1)
            color cc  = typ == 1 ? color.new(#22c55e, 40) : color.new(#3b82f6, 40)
            int tx = f_time_at_bar(tip)
            if not na(tx)
                label lb  = label.new(tx, px, xloc=xloc.bar_time, yloc=yloc.price,
                     style=label.style_circle, color=cc, size=size.tiny, text="")
                array.push(swingLbls, lb)
            prevTipBar := tip
        while array.size(swingLbls) > 200
            label.delete(array.shift(swingLbls))

// ════════════════════════════════════════════════════════════════════════════
// 11) TF + 1D TREND LABEL
// ════════════════════════════════════════════════════════════════════════════
var label tfLabel = na
if barstate.islast
    if uShowTfLabel
        string trendTxt = not htfReady ? "?1D" : trendUp ? "↑1D" : trendDown ? "↓1D" : "↔1D"
        string txt = "TF: " + timeframe.period + "  " + trendTxt
        if na(tfLabel)
            tfLabel := label.new(bar_index, high, xloc=xloc.bar_index, yloc=yloc.price,
                 text=txt, style=label.style_label_left, color=color(na),
                 textcolor=color.new(color.silver, 0), size=size.small,
                 tooltip="TF + 1D trend (close vs EMA200). Zóny vycházejí z aktuálního TF.")
        else
            label.set_x(tfLabel, bar_index)
            label.set_y(tfLabel, high)
            label.set_text(tfLabel, txt)
    else
        if not na(tfLabel)
            label.delete(tfLabel)
            tfLabel := na
