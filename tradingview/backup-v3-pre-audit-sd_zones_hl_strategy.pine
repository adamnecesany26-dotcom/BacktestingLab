//@version=6
// Zóny/swingy/BOS z OHLC grafu; trend filtr může použít HTF EMA přes request.security() (jako indikátor).
// title/shorttitle must be const strings — use optional label below for the active chart TF.
// Backtest fill model: `process_orders_on_close=false` allows limit orders to fill on the same bar
// when the bar's range touches the limit price (needed for long-history FX symbols).
// NOTE: pyramiding is set >0 so users can opt into multiple concurrent trades via `Max. otevřené obchody`.
strategy("S/D backtest (retest, 1R)", shorttitle="S/D backtest", overlay=true, format=format.price, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000, pyramiding=20, process_orders_on_close=false, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0)

float ATR_FLOOR = 0.0001
float MIN_THRESHOLD_ATR_RATIO = 0.24

// ——— Vstupy (parity indikátor v1.4.11 + Backtest) ———
string gB = "Základ"
string gV = "Vzhled"
string gF = "Filtry"
string gQ = "Kvalita zóny"
string gQM = "Meta zóny (induce, base, MFE)"
string gS = "Backtest"

string uSwingMode = input.string("Klasické", "Swingy", options=["Klasické", "Major"], group=gB, tooltip="Stejná logika jako indikátor.")
float uCitStrukt = input.float(0.93, "Citlivost struktury", minval=0.65, maxval=1.35, step=0.01, group=gB)
int uBosAcceptanceBars = input.int(1, "BOS acceptance (0–5)", minval=0, maxval=5, group=gB)
string uReadyMode = input.string("Close", "READY (odchod)", options=["Close", "Close_nebo_knot"], group=gB)

color uCdem = input.color(color.new(#22c55e, 86), "Demand – výplň", group=gV)
color uCsup = input.color(color.new(#ef4444, 86), "Supply – výplň", group=gV)

bool uZPasma = input.bool(true, "Pásma D/S", group=gV)
bool uZTecky = input.bool(true, "Tečky doteku (T)", group=gV)
bool uZbos = input.bool(true, "Čáry BOS", group=gV)
bool uZswing = input.bool(false, "Body swingů", group=gV)
bool uZtf = input.bool(true, "TF label vpravo", group=gV)
bool uDebugOverlay = input.bool(false, "Debug overlay", group=gV)
bool uDebugMarkOrders = input.bool(false, "Debug: značka E u příkazu", group=gV)
int inpTouchLabelMaxBars = input.int(0, "Štítky zón: max. od pravého kraje (bary, 0=vše)", minval=0, maxval=20000, group=gV, tooltip="P, debug, chop/far/end, kontaminace; 0 = celá viditelná historie.")

string uZoneSide = input.string("Obě", "Generovat zóny", options=["Obě", "Demand", "Supply"], group=gF)
bool uAlignWithTrend = input.bool(false, "Jen ve směru trendu", group=gF)
string uTrendSource = input.string("Proxy (aktuální TF)", "Trend", options=["Proxy (aktuální TF)", "HTF EMA (request.security)"], group=gF)
string uHtfTf = input.timeframe("240", "HTF (jen HTF trend)", group=gF)
int uTrendEmaLen = input.int(200, "EMA délka", minval=20, maxval=600, group=gF)

string uTouchPreset = input.string("Vyvážený", "Dotek po READY", options=["Citlivý (overlap)", "Vyvážený", "Přísný"], group=gF)
bool uTouchRequirePriorOutside = uTouchPreset != "Citlivý (overlap)"
bool uTouchStrictOutsidePrevBar = uTouchPreset == "Přísný"
bool uTouchRequireEdgeCross = uTouchPreset != "Citlivý (overlap)"

float uNearTouchPadAtr = input.float(0.15, "Near-touch pásmo (×ATR)", minval=0.0, maxval=2.0, step=0.05, group=gF, tooltip="0=vyp. Po READY: málem-dotek u hrany → silný odchod (viz další vstup).")
float uNearTouchStrongDepartAtr = input.float(0.35, "Near-touch: silný odchod (×ATR)", minval=0.0, maxval=3.0, step=0.05, group=gF, tooltip="Po málem-doteku close/knot musí zajet za hranou o ×ATR. 0 = jen přes hranou.")

bool inpContaminationEnabled = input.bool(true, "Kontaminace: odchod+návrat před READY → konec", group=gF, tooltip="Departure viz prahy níže → návrat (pomalý překryv / near-touch pásmo) před READY: zóna ihned končí (end 12).")
float uContamOverlapMaxFrac = input.float(0.30, "Kont.: A1 max. překryv range se zónou", minval=0.0, maxval=1.0, step=0.05, group=gF, tooltip="Momentum svíčka: jen pokud poměr překryvu range se zónou ≤ (větší část mimo).")
float uContamMomentumMinMult = input.float(0.60, "Kont.: A1 min. range / ATR", minval=0.0, maxval=5.0, step=0.05, group=gF)
float uContamBodyMinFrac = input.float(0.45, "Kont.: A1 min. |body| / range", minval=0.0, maxval=1.0, step=0.05, group=gF)
int uContamBarsOutsideMin = input.int(2, "Kont.: A2 bary řadě nad/pod zónou", minval=1, maxval=20, group=gF)
float uContamFullBarAvgMult = input.float(1.0, "Kont.: A3 range / sma(range)", minval=0.2, maxval=5.0, step=0.05, group=gF)
int uContamAvgRl = input.int(14, "Kont.: A3 sma délka (range)", minval=1, maxval=100, group=gF)
int uContamReturnBarsMin = input.int(2, "Kont.: B1 min. překryvů za sebou", minval=1, maxval=20, group=gF)
bool inpDebugContamination = input.bool(false, "Debug štítek kontaminace", group=gV)

float uMinZoneHeightAtr = input.float(0.28, "Min. výška zóny (×ATR)", minval=0.0, maxval=3.0, step=0.02, group=gQ)
int uMinBaseLen = input.int(3, "Min. délka base (bary)", minval=1, maxval=20, group=gQ)
float uMajorImpulseAtr = input.float(2.0, "Major impuls zóny (×ATR)", minval=0.5, maxval=10.0, step=0.1, group=gQ)

bool uInstEnabled = input.bool(true, "Institucionální režim (+ skóre)", group=gQ, tooltip="Skóre, únik/BOS při vzniku zóny, READY/arrival — jako indikátor.")
float uMinZoneScoreCreate = input.float(0.55, "Min. score při vzniku zóny", minval=0.0, maxval=1.0, step=0.01, group=gQ)
float uDepMinMoveAtr = input.float(1.25, "Min. únik od pivotu k BOS (×ATR)", minval=0.0, maxval=20.0, step=0.05, group=gQ, tooltip="Jen pokud je zapnutý institucionální režim. 0 = nevynucovat.")
float uDepMinBodyRatio = input.float(0.62, "Min. podíl těla u BOS", minval=0.0, maxval=1.0, step=0.02, group=gQ)

bool uUsePremiumDiscount = input.bool(false, "Premium/discount (filtr podle swingů)", group=gQ, tooltip="Demand jen níže od „midu“ struktury; supply jen výše.")
float uPDPadAtr = input.float(0.0, "P/D odsazení od midu (×ATR)", minval=0.0, maxval=10.0, step=0.05, group=gQ)

int uMetaMinBaseLen = input.int(0, "Min. délka base (0=vyp.)", minval=0, maxval=80, group=gQM)
int uMetaMaxBaseLen = input.int(0, "Max. délka base (0=vyp.)", minval=0, maxval=80, group=gQM)
float uMetaMinBosImpulseAtr = input.float(0.0, "Min. impuls od pivotu meta (×ATR)", minval=0.0, maxval=20.0, step=0.05, group=gQM, tooltip="0 = vyp.")
float uMetaMinMfeReadyAtr = input.float(0.0, "Min. MFE po READY pro obchod (×ATR)", minval=0.0, maxval=20.0, step=0.05, group=gQM, tooltip="0 = vyp.")

string uMetaInduceFilter = input.string("Vypnuto", "Inducement", options=["Vypnuto", "Jen se inducementem", "Jen inducement nahoře", "Jen inducement dole", "Bez inducement nahoře", "Bez inducement dole"], group=gQM)
int uInduceSwingLookback = input.int(10, "Swingů zpět", minval=1, maxval=80, group=gQM)
float uInducePadAtr = input.float(0.55, "Pásmo u hrany (×ATR)", minval=0.0, maxval=5.0, step=0.05, group=gQM)

string uEntryConfirm = input.string("Pinbar", "Potvrzení vstupu", options=["Off", "Pinbar", "Engulf"], group=gS, tooltip="Vstup jen při doteku hrany zóny (viz kód); volitelně Pinbar/Engulf na bar[1].")
int uEntryTimeoutBars = input.int(24, "Timeout limitu po READY (bary)", minval=0, maxval=2000, group=gS)
float inpStratSlMult = input.float(1.20, "Zarážka: násobitel výšky pásma (od hrany, 1.0 = u hrany, 1.2 = 20 % buffer mimo pásme)", minval=1.0, maxval=3.0, step=0.01, group=gS, tooltip="Stop: u poptávky pod dno, u nabídky nad vrchol pásma, plus (násobitel−1) × výška pásma.")
float inpStratR = input.float(1.0, "Cíl v R (zisk = násobek vzdálenosti entry–stop)", minval=0.1, maxval=20.0, step=0.1, group=gS, tooltip="Objednávka take-profit: R× riziko od vstupu (close).")
float inpStratQty = input.float(1.0, "Množství u vstupu (0 = 1; zvyš, pokud broker vyžaduje větší lot)", minval=0.0, maxval=1e7, step=0.1, group=gS, tooltip="Pevné množství na příkaz. 0 vnitřně nahradíme 1,0 jednotkou.")
int inpStratMaxHoldBars = input.int(0, "Max. držení (bary, 0 = vypnuto)", minval=0, maxval=200000, group=gS, tooltip="Bez tohoto může jeden trade zůstat otevřený roky a zablokovat nové vstupy (pyramiding=0). Pokud >0, po N barech se pozice ukončí na market.")
string inpStratFillMode = input.string("Limit (resting)", "Fill model", options=["Limit (resting)", "Assume fill on touch"], group=gS, tooltip="Limit (resting) = pokládáme limit na edge po READY a čekáme na fill. Assume fill on touch = pokud svíčka protne edge, vezmeme obchod jako vyplněný na edge (spolehlivé na dlouhé historii, méně realistické).")
int inpStratMaxOpenTrades = input.int(1, "Max. otevřené obchody (1 = bez souběhu)", minval=1, maxval=20, group=gS, tooltip="Pokud je 1 a zároveň je jeden obchod otevřený dlouho (TP/SL netrefí), backtest udělá jen pár obchodů za desítky let. Zvyš pro testování více retestů; vyžaduje pyramiding>0 (nastaveno).")

bool allowWickReady = uReadyMode == "Close_nebo_knot"

// --- Interní konstanty (parity indikátor v1.4.x) ---
float uTrendNeutralBandAtr = 0.0
float uMaxChopDensity = 0.70
int uMajorSwingLookback = 12
float uDepMinCloseAtr = 0.35
int uArrivalLookback = 6
float uArrivalMaxAtr = 1.35
float uArrivalMaxLastBarRangeAtr = 1.30

// --- Ostatní skryté „knoflíky“: pevné defaulty „Vyvážené“ (dříve Volné/Přísné menu) ---
float inpSensitivity = uCitStrukt
float inpAtrMult = 1.44
float inpSwingSpacing = 1.0
color inpColSwingHigh = color.new(#22c55e, 65)
color inpColSwingLow = color.new(#3b82f6, 65)
int inpBosWidth = 1
string inpBosStyle = "Dashed"
int inpBosMaxLookbackSwings = 20
