# Backend runs on port 8000 by default
#
# CORS (Next.js): default localhost / 127.0.0.1 / ::1 on port 3000.
# If you open the app via LAN (http://192.168.x.x:3000), add:
#   CORS_EXTRA_ORIGINS=http://192.168.1.10:3000
# Or allow any host on dev port 3000:
#   CORS_ALLOW_LAN_3000=1
# Advanced: CORS_ALLOW_ORIGIN_REGEX=^https://.*\.example\.com$
#
# Backtest runner (optional):
# RUN_TIMEOUT_SEC=3600
# RUN_STREAM_IDLE_TIMEOUT_SEC=1800
# RUN_DISCONNECT_GRACE_SEC=20
#
# S/D feature cache: signed pickle under .backtest_cache/features (legacy unsigned pickles still load)
# SD_ZONE_DISK_CACHE=1
# CACHE_HMAC_KEY=   # optional; shared secret for cache integrity (default dev key if unset)
#
# Engine lightweight result cache (in-process): TTL (monotonic seconds) and max entries
# RESULT_CACHE_TTL_SEC=3600
#
# /api/view + view_engine OHLC LRU (entries per process)
# VIEW_OHLC_CACHE_MAX=32
#
# Batch matrix (non-streaming): parallel workers use host subprocesses; 1 = serial in-process OK
# BATCH_PARALLEL_WORKERS=1
#
# Disk cache under DATA_CACHE_PATH: optional prune (runs at most once per ~120s when load_data uses cache)
# CACHE_DATASET_MAX_AGE_DAYS=0   # 0 = disabled; e.g. 14 deletes files older than 14 days
# CACHE_DATASET_MAX_TOTAL_MB=0   # 0 = disabled; cap total file size (evict oldest mtime first)
#
# Override equity-curve annualization when bar spacing is irregular (optional)
# TIMEFRAME_HINT=1h
#
# Engine execution mode (in-process is now DEFAULT ON — no subprocess overhead):
# Set to 0 to force subprocess execution (e.g., for untrusted code):
# RUN_INPROCESS_ENGINE=0
# Optional comma-separated code digests (sha256 hex) — if set, in-process runs only for matching strategy payloads:
# INPROCESS_ENGINE_DIGESTS=
# SSE streaming also uses in-process by default (single-user). Set to 0 for subprocess:
# RUN_INPROCESS_DURING_STREAM=0
#
# Performance tuning:
# MAX_OHLC_EXPORT_BARS=8000     # Server-side OHLC bar cap for chart export (default 8000)
#
# OHLC geometry validation: default STRICT (invalid bars raise). Set 0/false/off to log and continue:
# STRICT_OHLC_VALIDATION=0
